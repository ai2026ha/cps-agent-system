DATABASE_URL=sqlite:///./cps.db
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 后台业务时间统一按北京时间显示
BUSINESS_TIMEZONE=Asia/Shanghai

# 充值/支付服务调用平台币订单接口时使用，生产环境请设置高强度随机值
PAYMENT_CALLBACK_SECRET=replace-with-a-payment-callback-secret
# Exact reverse-proxy count. Keep 0 for direct/local access; use 1 for one trusted edge proxy.
TRUSTED_PROXY_HOPS=0

# 后台登录安全：同一IP在时间窗口内连续失败达到阈值后自动拉黑，需超管手工解除
ADMIN_LOGIN_FAILURE_LIMIT=8
ADMIN_LOGIN_FAILURE_WINDOW_SECONDS=600
